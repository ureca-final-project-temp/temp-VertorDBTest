# Common database and resource limits
POSTGRES_DB=vectorlab
POSTGRES_USER=vector
POSTGRES_PASSWORD=vector
VECTOR_CPU_LIMIT=4.0
VECTOR_MEMORY_LIMIT=8g
# Milvus total = main 3.0/6656MiB + etcd 0.5/512MiB + MinIO 0.5/1024MiB.
MILVUS_CPU_LIMIT=3.0
MILVUS_MEMORY_LIMIT=6656m
MILVUS_ETCD_CPU_LIMIT=0.5
MILVUS_ETCD_MEMORY_LIMIT=512m
MILVUS_MINIO_CPU_LIMIT=0.5
MILVUS_MINIO_MEMORY_LIMIT=1g
VECTOR_DIMENSION=1024
VECTOR_METRIC=COSINE
HNSW_M=16
HNSW_EF_CONSTRUCTION=128
HNSW_EF_SEARCH=100
PGVECTOR_FORCE_INDEX_SCAN=true
TARGET_RECALL_TOLERANCE=0.01

# Precomputed BGE-M3 inputs
DOCUMENT_VECTORS=data/embeddings/document-vectors.jsonl
QUERY_DEFINITIONS=data/queries/queries.jsonl
QUERY_VECTORS=data/embeddings/query-vectors.jsonl
BENCHMARK_RESULT_DIR=benchmark-result
